@prefix atom:   <http://lv2plug.in/ns/ext/atom#> .
@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix midi:   <http://lv2plug.in/ns/ext/midi#> .
@prefix mod:    <http://moddevices.com/ns/mod#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

<@URI@>
    a lv2:Plugin ;

    lv2:port
    [ a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "lv2_audio_in_1" ; lv2:name "Audio Input 1" ] ,
    [ a lv2:InputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "lv2_audio_in_2" ; lv2:name "Audio Input 2" ] ,
    [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 2 ; lv2:symbol "lv2_audio_out_1" ; lv2:name "Audio Output 1" ] ,
    [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 3 ; lv2:symbol "lv2_audio_out_2" ; lv2:name "Audio Output 2" ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "scale" ; lv2:name "Scale" ; lv2:portProperty lv2:integer, lv2:enumeration ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 7 ;
      lv2:scalePoint [ rdfs:label "Major" ; rdf:value 0 ] , [ rdfs:label "Minor" ; rdf:value 1 ] , [ rdfs:label "Dorian" ; rdf:value 2 ] , [ rdfs:label "Phrygian" ; rdf:value 3 ] , [ rdfs:label "Lydian" ; rdf:value 4 ] , [ rdfs:label "Mixolydian" ; rdf:value 5 ] , [ rdfs:label "Harmonic Minor" ; rdf:value 6 ] , [ rdfs:label "Melodic Minor" ; rdf:value 7 ] ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 5 ; lv2:symbol "interval" ; lv2:name "Interval" ; lv2:portProperty lv2:integer, lv2:enumeration ; lv2:default 4 ; lv2:minimum 0 ; lv2:maximum 8 ;
      lv2:scalePoint [ rdfs:label "Unison" ; rdf:value 0 ] , [ rdfs:label "2nd" ; rdf:value 1 ] , [ rdfs:label "3rd" ; rdf:value 2 ] , [ rdfs:label "4th" ; rdf:value 3 ] , [ rdfs:label "5th" ; rdf:value 4 ] , [ rdfs:label "6th" ; rdf:value 5 ] , [ rdfs:label "7th" ; rdf:value 6 ] , [ rdfs:label "Octave" ; rdf:value 7 ] , [ rdfs:label "Polyphonic" ; rdf:value 8 ] ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 6 ; lv2:symbol "interval_detune" ; lv2:name "Interval Fine Detune" ; lv2:default 0.000000 ; lv2:minimum -50.000000 ; lv2:maximum 50.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 7 ; lv2:symbol "harmony_level" ; lv2:name "Harmony Level" ; lv2:default 0.820000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 8 ; lv2:symbol "harmony_direction" ; lv2:name "Harmony Direction" ; lv2:portProperty lv2:integer, lv2:enumeration ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ;
      lv2:scalePoint [ rdfs:label "Up" ; rdf:value 0 ] , [ rdfs:label "Down" ; rdf:value 1 ] ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 9 ; lv2:symbol "scale_snap" ; lv2:name "Scale Snap" ; lv2:portProperty lv2:integer, lv2:enumeration ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 2 ;
      lv2:scalePoint [ rdfs:label "Nearest" ; rdf:value 0 ] , [ rdfs:label "Up" ; rdf:value 1 ] , [ rdfs:label "Down" ; rdf:value 2 ] ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 10 ; lv2:symbol "tone" ; lv2:name "Tone" ; lv2:default 0.550000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 11 ; lv2:symbol "mallet_hardness" ; lv2:name "Mallet Hardness" ; lv2:default 0.350000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 12 ; lv2:symbol "strike_noise" ; lv2:name "Strike Noise" ; lv2:default 0.200000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 13 ; lv2:symbol "bar_decay" ; lv2:name "Bar Decay" ; lv2:default 0.650000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 14 ; lv2:symbol "velocity_sens" ; lv2:name "Velocity Sens" ; lv2:default 0.750000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 15 ; lv2:symbol "amp_attack" ; lv2:name "Amp Attack" ; lv2:default 0.000000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 16 ; lv2:symbol "amp_hold" ; lv2:name "Amp Hold" ; lv2:default 0.000000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 17 ; lv2:symbol "amp_decay" ; lv2:name "Amp Decay" ; lv2:default 0.550000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 18 ; lv2:symbol "amp_sustain" ; lv2:name "Amp Sustain" ; lv2:default 0.000000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 19 ; lv2:symbol "amp_release" ; lv2:name "Amp Release" ; lv2:default 0.350000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 20 ; lv2:symbol "filter_type" ; lv2:name "Filter Type" ; lv2:portProperty lv2:integer, lv2:enumeration ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 2 ;
      lv2:scalePoint [ rdfs:label "Lowpass" ; rdf:value 0 ] , [ rdfs:label "Highpass" ; rdf:value 1 ] , [ rdfs:label "Bandpass" ; rdf:value 2 ] ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 21 ; lv2:symbol "cutoff" ; lv2:name "Cutoff" ; lv2:portProperty pprops:logarithmic ; lv2:default 20000.000000 ; lv2:minimum 20.000000 ; lv2:maximum 20000.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 22 ; lv2:symbol "resonance" ; lv2:name "Resonance" ; lv2:default 0.000000 ; lv2:minimum 0.000000 ; lv2:maximum 0.980000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 23 ; lv2:symbol "drive" ; lv2:name "Drive" ; lv2:default 0.000000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 24 ; lv2:symbol "filt_env_amt" ; lv2:name "Filter Env Amount" ; lv2:default 0.000000 ; lv2:minimum -1.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 25 ; lv2:symbol "filt_attack" ; lv2:name "Filter Attack" ; lv2:default 0.000000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 26 ; lv2:symbol "filt_hold" ; lv2:name "Filter Hold" ; lv2:default 0.000000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 27 ; lv2:symbol "filt_decay" ; lv2:name "Filter Decay" ; lv2:default 0.000000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 28 ; lv2:symbol "filt_sustain" ; lv2:name "Filter Sustain" ; lv2:default 0.000000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 29 ; lv2:symbol "filt_release" ; lv2:name "Filter Release" ; lv2:default 0.000000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 30 ; lv2:symbol "tremolo_rate" ; lv2:name "Tremolo Rate" ; lv2:default 5.500000 ; lv2:minimum 0.100000 ; lv2:maximum 12.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 31 ; lv2:symbol "tremolo_depth" ; lv2:name "Tremolo Depth" ; lv2:default 0.350000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 32 ; lv2:symbol "width" ; lv2:name "Width" ; lv2:default 0.650000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 33 ; lv2:symbol "gain" ; lv2:name "Gain" ; lv2:default 0.700000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 34 ; lv2:symbol "spring_mix" ; lv2:name "Spring Mix" ; lv2:default 0.100000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 35 ; lv2:symbol "spring_decay" ; lv2:name "Spring Decay" ; lv2:default 0.450000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 36 ; lv2:symbol "spring_tone" ; lv2:name "Spring Tone" ; lv2:default 0.550000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 37 ; lv2:symbol "spring_drive" ; lv2:name "Spring Drive" ; lv2:default 0.200000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 38 ; lv2:symbol "spring_shake" ; lv2:name "Spring Shake" ; lv2:default 0.000000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 39 ; lv2:symbol "delay_mix" ; lv2:name "Delay Mix" ; lv2:default 0.000000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 40 ; lv2:symbol "delay_time" ; lv2:name "Delay Time" ; lv2:default 360.000000 ; lv2:minimum 40.000000 ; lv2:maximum 1600.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 41 ; lv2:symbol "delay_feedback" ; lv2:name "Delay Feedback" ; lv2:default 0.350000 ; lv2:minimum 0.000000 ; lv2:maximum 0.920000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 42 ; lv2:symbol "tape_tone" ; lv2:name "Tape Tone" ; lv2:default 0.550000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 43 ; lv2:symbol "wow_flutter" ; lv2:name "Wow Flutter" ; lv2:default 0.150000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 44 ; lv2:symbol "tape_age" ; lv2:name "Tape Age" ; lv2:default 0.250000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 45 ; lv2:symbol "head_mode" ; lv2:name "Head Mode" ; lv2:portProperty lv2:integer, lv2:enumeration ; lv2:default 6 ; lv2:minimum 0 ; lv2:maximum 6 ;
      lv2:scalePoint [ rdfs:label "Head 1" ; rdf:value 0 ] , [ rdfs:label "Head 2" ; rdf:value 1 ] , [ rdfs:label "Head 3" ; rdf:value 2 ] , [ rdfs:label "Head 1+2" ; rdf:value 3 ] , [ rdfs:label "Head 2+3" ; rdf:value 4 ] , [ rdfs:label "Head 1+3" ; rdf:value 5 ] , [ rdfs:label "Head 1+2+3" ; rdf:value 6 ] ] ,

    [ a atom:AtomPort, lv2:InputPort ; lv2:index 46 ; lv2:symbol "midi_in" ; lv2:name "MIDI In" ; lv2:designation lv2:control ; atom:bufferType atom:Sequence ; atom:supports midi:MidiEvent ] ;

    rdfs:comment "Polyphonic or interval-harmony vibraphone with ADHSR filter, spring reverb, and multi-head tape echo." ;
    mod:brand "TT Lab" ;
    mod:label "Vibraphone" ;
    doap:name "Vibraphone" ;
    doap:license "GPL-2.0-only" ;
    doap:developer [ foaf:name "TT Lab" ] ;
    lv2:microVersion 9 ;
    lv2:minorVersion 0 .
